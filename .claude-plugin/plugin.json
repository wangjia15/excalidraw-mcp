{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "excalidraw-obsidian",
  "version": "0.5.0",
  "description": "Excalidraw drawings in Obsidian vaults: templates, mind maps, slides, paper boards and visual knowledge cards, with paper-zettel, boppps-lesson and excalidraw-topic skills",
  "author": {
    "name": "wangjia15"
  },
  "homepage": "https://github.com/wangjia15/excalidraw-mcp",
  "repository": "https://github.com/wangjia15/excalidraw-mcp",
  "license": "MIT",
  "keywords": [
    "excalidraw",
    "obsidian",
    "mcp",
    "slides",
    "mindmap",
    "zettelkasten",
    "boppps"
  ],
  "mcpServers": {
    "excalidraw-obsidian": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/index.js",
        "--stdio"
      ],
      "env": {
        "OBSIDIAN_VAULT": "${OBSIDIAN_VAULT:-}"
      }
    }
  }
}
